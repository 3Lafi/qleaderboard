rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    match /leaderboards/{boardId} {
      // أي شخص لديه الرابط يمكنه القراءة إذا كانت اللوحة عامة؛ المالك يقرأ دائماً
      allow get: if (resource.data.settings.isPublic == true) ||
                    (request.auth != null && request.auth.uid == resource.data.ownerUid);

      // سرد اللوحات مسموح فقط عند تصفية ownerUid == uid (يمنع تعداد كل اللوحات علناً)
      allow list: if request.auth != null
                  && request.auth.uid == resource.data.ownerUid;

      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.settings.name is string
                    && request.resource.data.settings.name.size() > 0
                    && request.resource.data.settings.name.size() < 200;

      allow update: if isOwner()
                    && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if isOwner();
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
