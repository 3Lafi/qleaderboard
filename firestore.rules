rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    function isValidBoardName(name) {
      return name is string && name.size() > 0 && name.size() <= 100;
    }

    // الدفعات: قائمة طلاب يملكها المعلم — لا قراءة عامة إطلاقاً
    match /cohorts/{cohortId} {
      allow get, list: if request.auth != null && request.auth.uid == resource.data.ownerUid;

      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.students == {}
                    && request.resource.data.createdAt == request.time;

      allow update, delete: if isOwner();
    }

    match /leaderboards/{boardId} {
      // أي شخص لديه الرابط يمكنه القراءة إذا كانت اللوحة عامة؛ المالك يقرأ دائماً
      allow get: if (resource.data.settings.isPublic == true) ||
                    (request.auth != null && request.auth.uid == resource.data.ownerUid);

      // سرد اللوحات مسموح فقط عند تصفية ownerUid == uid (يمنع تعداد كل اللوحات علناً)
      allow list: if request.auth != null
                  && request.auth.uid == resource.data.ownerUid;

      // banner اختياري عند الإنشاء (وليس إلزامياً) عمداً: عملاء قدامى قد يبقون مخبّئين
      // لدى المتصفح (Cache-Control على ملفات JS + service worker) لغاية ساعة بعد كل نشر —
      // لو أُلزم هنا لرفضت القاعدة إنشاء أي لوحة من عميل قديم لا يرسل الحقل أصلاً.
      // لو أُرسل يجب أن يكون بالشكل الصحيح؛ لو غاب فالقراءة اللاحقة تفترض السمة الافتراضية
      // (انظر Leaderboard.js) وتُثبَّت لاحقاً عبر مسار "لوحة قديمة" في قاعدة update أدناه.
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && isValidBoardName(request.resource.data.settings.name)
                    && request.resource.data.settings.isPublic is bool
                    && (!('banner' in request.resource.data.settings)
                        || request.resource.data.settings.banner.themeId is string)
                    && request.resource.data.students == {}
                    && (!('initialBanner' in request.resource.data)
                        || (request.resource.data.initialBanner.name == request.resource.data.settings.name
                            && request.resource.data.initialBanner.schoolName == request.resource.data.settings.schoolName
                            && request.resource.data.initialBanner.classLabel == request.resource.data.settings.classLabel
                            && request.resource.data.initialBanner.banner == request.resource.data.settings.banner))
                    && request.resource.data.createdAt == request.time;

      // ملاحظة: لا يمكن التحقق من شكل كل عنصر داخل خريطة students هنا — لغة قواعد
      // Firestore لا توفر تكراراً (forEach/all) على عناصر خريطة بمفاتيح غير معروفة مسبقاً.
      // التحقق الكامل من الشكل يحدث في طبقة العميل (BoardSettings.sanitizeSettings)؛
      // إن احتجنا ضماناً على مستوى القواعد مستقبلاً فالحل هو نقل الطلاب إلى subcollection
      // حيث يكون لكل طالب مستند خاص به قابل للتحقق بشكل مستقل.
      // تصميم البانر يمكن اختياره وتعديله من قبل مالك اللوحة في أي وقت.
      allow update: if isOwner()
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['initialBanner'])
                    && request.resource.data.createdAt == resource.data.createdAt
                    && isValidBoardName(request.resource.data.settings.name)
                    && request.resource.data.settings.isPublic is bool
                    && (!('banner' in request.resource.data.settings)
                        || request.resource.data.settings.banner.themeId is string)
                    && request.resource.data.students.size() <= 150;

      allow delete: if isOwner();
    }

    // Keep JPEG data outside the board document so student updates stay small.
    match /boardPreviews/{boardId} {
      function board() { return get(/databases/$(database)/documents/leaderboards/$(boardId)); }
      function nextBoard() { return getAfter(/databases/$(database)/documents/leaderboards/$(boardId)); }
      allow get: if board().data.settings.isPublic == true
                 || (request.auth != null && board().data.ownerUid == request.auth.uid);
      allow create, update: if request.auth != null
                           && nextBoard().data.ownerUid == request.auth.uid
                           && request.resource.data.keys().hasOnly(['version', 'jpeg'])
                           && request.resource.data.version is string
                           && request.resource.data.version.matches('^[a-f0-9]{64}$')
                           && request.resource.data.jpeg is string
                           && request.resource.data.jpeg.size() > 0
                           && request.resource.data.jpeg.size() <= 250000;
      allow delete: if request.auth != null && board().data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
