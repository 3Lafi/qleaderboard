rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    function isValidBoardName(name) {
      return name is string && name.size() > 0 && name.size() <= 100;
    }

    match /leaderboards/{boardId} {
      // أي شخص لديه الرابط يمكنه القراءة إذا كانت اللوحة عامة؛ المالك يقرأ دائماً
      allow get: if (resource.data.settings.isPublic == true) ||
                    (request.auth != null && request.auth.uid == resource.data.ownerUid);

      // سرد اللوحات مسموح فقط عند تصفية ownerUid == uid (يمنع تعداد كل اللوحات علناً)
      allow list: if request.auth != null
                  && request.auth.uid == resource.data.ownerUid;

      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && isValidBoardName(request.resource.data.settings.name)
                    && request.resource.data.settings.isPublic is bool
                    && request.resource.data.settings.banner.themeId is string
                    && request.resource.data.students == {}
                    && request.resource.data.createdAt == request.time;

      // ملاحظة: لا يمكن التحقق من شكل كل عنصر داخل خريطة students هنا — لغة قواعد
      // Firestore لا توفر تكراراً (forEach/all) على عناصر خريطة بمفاتيح غير معروفة مسبقاً.
      // التحقق الكامل من الشكل يحدث في طبقة العميل (BoardSettings.sanitizeSettings)؛
      // إن احتجنا ضماناً على مستوى القواعد مستقبلاً فالحل هو نقل الطلاب إلى subcollection
      // حيث يكون لكل طالب مستند خاص به قابل للتحقق بشكل مستقل.
      // تصميم البانر يُختار مرة واحدة: بعد حفظه لا يمكن تغييره أبداً.
      // اللوحات القديمة (قبل الميزة، بلا banner) يُسمح لها بإضافته مرة واحدة فقط
      // — أول تحديث يثبّت السمة الافتراضية ثم يُقفل.
      allow update: if isOwner()
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && isValidBoardName(request.resource.data.settings.name)
                    && request.resource.data.settings.isPublic is bool
                    && (!('banner' in resource.data.settings)
                        || request.resource.data.settings.banner == resource.data.settings.banner)
                    && request.resource.data.students.size() <= 150;

      allow delete: if isOwner();
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
