{
  "name": "wisam",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:rules:run": "node --test tests/rules/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore \"npm run test:rules:run\"",
    "test:rules:emulator": "firebase emulators:start --only firestore",
    "dev": "node scripts/dev-server.mjs",
    "check": "node scripts/check-project.mjs",
    "og:check": "node scripts/generate-og-previews.mjs --check",
    "verify": "npm run check && npm test"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.1.0",
    "playwright": "^1.61.1"
  }
}
