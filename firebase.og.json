{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8081
    }
  },
  "hosting": {
    "target": "wisam",
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "README.md",
      "package.json",
      "package-lock.json",
      "**/.*",
      "node_modules/**",
      "**/node_modules/**",
      "scripts/**",
      "tests/**",
      "docs/**",
      "tools/**",
      "**/*.log",
      "README.md",
      "LICENSE",
      "package-lock.json",
      "functions/**",
      "workers/**",
      "firebase.og.json",
      "b/**",
      "images/og/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/b/**",
        "function": {
          "functionId": "boardPreview",
          "region": "us-central1"
        }
      },
      {
        "source": "/og/**",
        "function": {
          "functionId": "boardPreview",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.googleusercontent.com; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.gstatic.com https://fonts.googleapis.com https://fonts.gstatic.com; frame-src https://wisam-3lafi.firebaseapp.com https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|svg|webp|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "images/og/*.jpg",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/almanhaj",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/almanhaj.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/juz_amma",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/juz_amma.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/juz_tabarak",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/juz_tabarak.html",
        "destination": "/",
        "type": 301
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "og",
      "predeploy": [
        "node scripts/prepare-og-functions.mjs"
      ]
    }
  ]
}
